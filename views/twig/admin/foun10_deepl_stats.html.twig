{% include "headitem.html.twig" with {title: "foun10 DeepL"} %}

<style>
    .foun10dl-wrap { padding: 4px 14px 20px; }
    .foun10dl-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .foun10dl-header h1 { margin: 0; }
    .foun10dl-badge { display: inline-block; padding: 3px 10px; border-radius: 10px; font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: .03em; }
    .foun10dl-badge-on { background: #dff0d8; color: #3c763d; border: 1px solid #b2d8a8; }
    .foun10dl-badge-warn { background: #fcf8e3; color: #8a6d3b; border: 1px solid #faebcc; }
    .foun10dl-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 4px; padding: 14px 16px; margin-bottom: 16px; }
    .foun10dl-card h2 { font-size: 14px; margin: 0 0 10px; text-transform: uppercase; letter-spacing: .03em; color: #555; }
    .foun10dl-error { color: #a94442; background: #f2dede; border: 1px solid #ebccd1; padding: 6px 8px; border-radius: 3px; margin-top: 6px; }
    .foun10dl-empty { color: #888; font-style: italic; padding: 6px 0; }
    .foun10dl-stats-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .foun10dl-stats-table th, .foun10dl-stats-table td { padding: 7px 10px; border-bottom: 1px solid #eee; text-align: right; }
    .foun10dl-stats-table th:first-child, .foun10dl-stats-table td:first-child { text-align: left; }
    .foun10dl-stats-table th { color: #555; font-size: 11px; text-transform: uppercase; letter-spacing: .03em; border-bottom: 2px solid #ddd; }
    .foun10dl-stats-table tfoot td { font-weight: bold; border-top: 2px solid #ddd; border-bottom: none; }
    .foun10dl-usage-numbers { font-size: 20px; font-weight: bold; margin-bottom: 6px; }
    .foun10dl-usage-numbers small { font-size: 13px; font-weight: normal; color: #777; }
    .foun10dl-usage-bar { width: 100%; max-width: 420px; height: 10px; background: #eee; border-radius: 5px; overflow: hidden; }
    .foun10dl-usage-bar-fill { display: block; height: 100%; background: #5cb85c; }
    .foun10dl-usage-bar-fill.foun10dl-usage-bar-warn { background: #f0ad4e; }
    .foun10dl-usage-bar-fill.foun10dl-usage-bar-danger { background: #d9534f; }
    .foun10dl-totals-row { display: flex; gap: 28px; margin-bottom: 12px; flex-wrap: wrap; }
    .foun10dl-total-item strong { display: block; font-size: 18px; }
    .foun10dl-total-item span { color: #777; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
</style>

<div class="foun10dl-wrap">
    <div class="foun10dl-header">
        <h1>{{ translate({ ident: "FOUN10_DEEPL" }) }}</h1>
        {% if deepLTestModeActive %}
            <span class="foun10dl-badge foun10dl-badge-warn">{{ translate({ ident: "DL_STATUS_TEST" }) }}</span>
        {% else %}
            <span class="foun10dl-badge foun10dl-badge-on">{{ translate({ ident: "DL_STATUS_LIVE" }) }}</span>
        {% endif %}
    </div>

    <div class="foun10dl-card">
        <h2>{{ translate({ ident: "DL_SECTION_USAGE" }) }}</h2>

        {% if deepLUsageError %}
            <p class="foun10dl-error">{{ translate({ ident: "DL_USAGE_ERROR_PREFIX" }) }}: {{ deepLUsageError }}</p>
        {% elseif not deepLUsage %}
            <p class="foun10dl-empty">{{ translate({ ident: "DL_USAGE_NO_DATA" }) }}</p>
        {% else %}
            {% if deepLUsage.limit > 0 and deepLUsage.limit < 100000000000 %}
                {% set foun10dlUsageRatio = deepLUsage.count * 100 / deepLUsage.limit %}
                <div class="foun10dl-usage-numbers">
                    {{ deepLUsage.count|number_format(0, ',', '.') }} <small>/ {{ deepLUsage.limit|number_format(0, ',', '.') }} {{ translate({ ident: "DL_USAGE_CHARACTERS_LABEL" }) }} ({{ "%.1f"|format(foun10dlUsageRatio) }}&nbsp;%)</small>
                </div>
                <div class="foun10dl-usage-bar">
                    <span class="foun10dl-usage-bar-fill{% if foun10dlUsageRatio >= 100 %} foun10dl-usage-bar-danger{% elseif foun10dlUsageRatio >= 80 %} foun10dl-usage-bar-warn{% endif %}" style="width: {% if foun10dlUsageRatio > 100 %}100{% else %}{{ foun10dlUsageRatio }}{% endif %}%;"></span>
                </div>
            {% else %}
                <div class="foun10dl-usage-numbers">
                    {{ deepLUsage.count|number_format(0, ',', '.') }} <small>{{ translate({ ident: "DL_USAGE_CHARACTERS_LABEL" }) }} ({{ translate({ ident: "DL_USAGE_NO_LIMIT" }) }})</small>
                </div>
            {% endif %}
        {% endif %}
    </div>

    <div class="foun10dl-card">
        <h2>{{ translate({ ident: "DL_SECTION_CACHE" }) }}</h2>

        <div class="foun10dl-totals-row">
            <div class="foun10dl-total-item">
                <strong>{{ deepLCacheTotals.entries|number_format(0, ',', '.') }}</strong>
                <span>{{ translate({ ident: "DL_CACHE_TOTAL_ENTRIES" }) }}</span>
            </div>
            <div class="foun10dl-total-item">
                <strong>{{ deepLCacheTotals.characters|number_format(0, ',', '.') }}</strong>
                <span>{{ translate({ ident: "DL_CACHE_TOTAL_CHARACTERS" }) }}</span>
            </div>
            {% if deepLCacheTotals.newest %}
                <div class="foun10dl-total-item">
                    <strong>{{ deepLCacheTotals.newest|date("d.m.Y H:i") }}</strong>
                    <span>{{ translate({ ident: "DL_CACHE_NEWEST_ENTRY" }) }}</span>
                </div>
            {% endif %}
        </div>

        {% if deepLCacheByLanguage|length == 0 %}
            <p class="foun10dl-empty">{{ translate({ ident: "DL_CACHE_EMPTY" }) }}</p>
        {% else %}
            <table class="foun10dl-stats-table">
                <thead>
                    <tr>
                        <th>{{ translate({ ident: "DL_TABLE_FROM_LANG" }) }}</th>
                        <th>{{ translate({ ident: "DL_TABLE_TO_LANG" }) }}</th>
                        <th>{{ translate({ ident: "DL_TABLE_CACHE_ENTRIES" }) }}</th>
                        <th>{{ translate({ ident: "DL_TABLE_CACHE_CHARACTERS" }) }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in deepLCacheByLanguage %}
                        <tr>
                            <td>{{ row.fromLang }}</td>
                            <td>{{ row.toLang }}</td>
                            <td>{{ row.entries|number_format(0, ',', '.') }}</td>
                            <td>{{ row.characters|number_format(0, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td>{{ translate({ ident: "DL_TABLE_TOTAL" }) }}</td>
                        <td></td>
                        <td>{{ deepLCacheTotals.entries|number_format(0, ',', '.') }}</td>
                        <td>{{ deepLCacheTotals.characters|number_format(0, ',', '.') }}</td>
                    </tr>
                </tfoot>
            </table>
        {% endif %}
    </div>
</div>

{% include "bottomitem.html.twig" %}
